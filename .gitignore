# ============================================================
# tiancode .gitignore —— 提交纪律的强制执行（单一定义源见 docs/STANDARDS.md）
# 原则：不该提交的坚决不提交；例外白名单必须在 README 中声明理由。
# ============================================================

# --- 依赖与构建产物（永不入库） ---
node_modules/
# dist 构建产物忽略，但保留 .gitkeep 占位（go:embed all:frontend/dist 需要目录存在）
frontend/dist/*
!frontend/dist/.gitkeep
*.exe
bin/
build/
dist/

# --- 运行时数据（永不入库） ---
data/
*.db
*.sqlite
*.sqlite3
logs/
*.log

# --- 密钥与环境（永不入库；API Key 只进环境变量） ---
.env
.env.*
*.local

# --- 临时文件与个人 IDE 配置（永不入库） ---
tmp/
.tmp/
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Go 工具产物（永不入库） ---
coverage.out
*.test
*.out

# --- 安装器 payload（构建时由 release.ps1 生成，仅保留 .gitkeep 占位） ---
cmd/installer/payload/*
!cmd/installer/payload/.gitkeep

# ------------------------------------------------------------
# 白名单例外（必须入库，禁止加入上方忽略）：
#   vendor/           —— Go 官方 vendor 机制，保证离线/新环境可构建
#   frontend/wailsjs/ —— Wails 生成绑定，前端编译依赖，避免构建顺序耦合
# ------------------------------------------------------------
