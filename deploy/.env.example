# 复制为 /opt/tiancode/.env（chmod 600），同样内容存进 Jenkins Secret file 凭据 tiancode-deploy-env。
# JWT_SECRET / ADMIN_PASSWORD 若缺失，或仍等于这些占位符
# （以及旧 README 里的 AdminPassword123!、tiancode-family-secret-32-bytes-min!），进程会拒绝启动。
# 数据库口令若仍是 change-me-pg-password，同样拒绝启动。
# 替换方式：
#   JWT_SECRET=$(openssl rand -hex 32)
#   ADMIN_PASSWORD=$(openssl rand -base64 24)   # 至少 12 位；含 / + = 时写进 URL 要编码
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)   # 只用十六进制，避免 URL 被 @ : / 截断
# 不要复用 agent-memory 的 deploy-env（端口和密钥都不同）。
# IMAGE / TAG 由 Jenkins 在 compose up 时注入，不要写在这里。
# TIANCODE_DB 已废弃。SQLite 文件不会被导入。

JWT_SECRET=change-me-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
API_PORT=8092
ROOT_PATH=/tiancode

POSTGRES_USER=tiancode
POSTGRES_PASSWORD=change-me-pg-password
POSTGRES_DB=tiancode
# 给宿主机上的 uvicorn 用。compose 会用服务名 postgres 覆盖这条。
TIANCODE_DATABASE_URL=postgresql://tiancode:change-me-pg-password@127.0.0.1:5432/tiancode

# 只信任本机代理头。不要设成 *。Docker 网桥上的 nginx 若要让 uvicorn 采信
# X-Forwarded-Proto，改成那个网桥地址（常见 172.17.0.1），并在 nginx 前做 TLS。
FORWARDED_ALLOW_IPS=127.0.0.1
